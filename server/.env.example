# Application runtime settings
APP_NAME=Centralized Computer Monitoring Server
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# SQLite database location, relative to the server directory
DATABASE_URL=sqlite:///./monitoring.db

# Required before an agent can register. Generate long random values for both.
AGENT_REGISTRATION_KEY=replace-with-a-long-random-registration-key
AGENT_TOKEN_PEPPER=replace-with-a-different-long-random-server-secret
