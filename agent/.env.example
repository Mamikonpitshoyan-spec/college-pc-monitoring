# Monitoring Server connection
# Use the admin PC LAN IP when running on another computer, e.g. http://192.168.1.50:8000
MONITORING_SERVER_URL=http://127.0.0.1:8000

# Must match AGENT_REGISTRATION_KEY configured on the server
MONITORING_REGISTRATION_KEY=replace-with-the-server-registration-key

# Optional overrides
# Один раз: сопряжение по коду от администратора (вместо ключа регистрации)
# MONITORING_PAIRING_CODE=A7K-29P
# MONITORING_AGENT_ID=PC-01
# MONITORING_TOKEN_PATH=.agent_token.json
# MONITORING_REPORT_INTERVAL_SECONDS=5
# MONITORING_REQUEST_TIMEOUT_SECONDS=5
# MONITORING_LOG_LEVEL=INFO
